# Copy to .env (pnpm dev does this for you on first run).

# API keys. Read by the server only; never sent to the browser.
# Models starting with gemini- use GEMINI_API_KEY; models starting with claude- use ANTHROPIC_API_KEY.
# You only need the key for the models you use.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Port the local server listens on (bound to 127.0.0.1 only).
PORT=4317

# Port of the Vite dev server used by `pnpm dev`.
DEV_WEB_PORT=5173

# Folder for the SQLite file, uploaded resumes and saved settings.
DATA_DIR=./data

# Models. Matching uses a small model; resume import uses a stronger one.
# Leave empty for the defaults: gemini-3.5-flash-lite / gemini-3.8-flash when GEMINI_API_KEY is set,
# otherwise claude-haiku-5-5 / claude-opus-5-5. The Settings screen can override these.
MATCH_MODEL=
IMPORT_MODEL=

# Public internship listings file. The repo name changes each recruiting season.
LISTINGS_URL=https://raw.githubusercontent.com/SimplifyJobs/Summer2027-Internships/dev/.github/scripts/listings.json

# Default pull window in days (any number up to 3650, or 0 for all).
PULL_WINDOW_DAYS=7

# Random token required on every API call. Generated on first run if empty.
QUIPPLY_TOKEN=
