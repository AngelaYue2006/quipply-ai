{
  "name": "quipply-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local internship tracker: profile, job board and match scoring (V1).",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "tsx scripts/ensure-env.ts && concurrently -k -n api,web -c blue,green \"tsx watch --clear-screen=false src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "match:demo": "tsx src/match/demo.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/static": "10.1.8",
    "@mozilla/readability": "0.6.0",
    "better-sqlite3": "12.11.1",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "jsdom": "27.4.0",
    "unpdf": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hookform/resolvers": "7.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.24",
    "@types/better-sqlite3": "9.6.0",
    "@types/jsdom": "27.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
